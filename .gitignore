# ──────────────────────────────────────────
#  Co-op Roguelike - .gitignore
# ──────────────────────────────────────────

# ── Node / Client ──────────────────────────
node_modules/
client/node_modules/
dist/
client/dist/
.vite/

# ── Wasm build artifacts (built by Docker) ──
# engine.wasm 은 빌드 산출물이므로 무시
# wasm_exec.js 도 TinyGo 이미지에서 복사되므로 무시
client/public/wasm/engine.wasm
client/public/wasm/wasm_exec.js
engine/build/

# ── Go ────────────────────────────────────
# vendor 폴더를 쓰지 않는 경우
engine/vendor/
# 컴파일 캐시
*.test
*.out

# ── OS / Editor ───────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

.idea/
.vscode/
*.suo
*.user
*.swp
*.swo
*~

# ── Env / Secrets ─────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ── Logs ─────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Antigravity AI agent (로컬 전용) ──────
.gemini/
.agents/rules/*.local.md

# ── Replay files (로컬 테스트용) ─────────
replay_*.json
